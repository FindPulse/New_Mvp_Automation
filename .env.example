# App
APP_ENV=local
LOG_LEVEL=INFO

# WooCommerce read-only connector
WOO_SITE_URL=https://example.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx

# Supabase/Postgres wheel library
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Microsoft Graph / Outlook device login
MICROSOFT_CLIENT_ID=your-app-client-id

# Optional AI summary
OPENAI_API_KEY=
